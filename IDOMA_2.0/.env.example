# Database: lascia vuoto per usare PersonalAI/personal_ai.db senza spostarlo.
# In cloud imposta un percorso persistente, ad esempio /data/personal_ai.db.
IDOMA_DB_PATH=

# Modello locale Ollama
IDOMA_OLLAMA_URL=http://127.0.0.1:11434/api/chat
IDOMA_OLLAMA_MODEL=qwen3:1.7b
IDOMA_OLLAMA_TIMEOUT=180
IDOMA_PREFER_LOCAL=1
# Set to 1 only if you explicitly consent to sending prompts/memory to a cloud AI provider.
IDOMA_ALLOW_CLOUD=0

# Provider cloud OpenAI-compatible (facoltativo; richiede una API key).
# Non inserire la chiave nel codice o nell'app iPhone.
IDOMA_CLOUD_BASE_URL=
IDOMA_CLOUD_API_KEY=
IDOMA_CLOUD_MODEL=

# Sicurezza: in locale il token viene generato automaticamente al primo avvio.
# In produzione impostare un valore lungo e casuale.
IDOMA_API_TOKEN=
IDOMA_ENV=development
IDOMA_CORS_ORIGINS=*

# URL usato dall'agente Windows per collegarsi al server centrale.
# In locale: http://127.0.0.1:8000 ; in cloud: https://tuo-dominio.example.com
IDOMA_SERVER_URL=http://127.0.0.1:8000

# Local-only by default. Use a VPN/tunnel for remote access.
IDOMA_BIND_HOST=127.0.0.1
IDOMA_PORT=8000
